# ─── Database ─────────────────────────────────────────
# IMPORTANT: In production, use Azure Key Vault or managed identity
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/arya?schema=public"
PRISMA_DATASOURCE_URL="postgresql://USER:PASSWORD@HOST:PORT/arya?schema=public"

# ─── Redis ────────────────────────────────────────────
# LOCAL DEV (docker-compose): plaintext on port 6379, no password, no TLS.
#   REDIS_HOST=localhost
#   REDIS_PORT=6379
#   REDIS_PASSWORD=
#
# PRODUCTION (Azure Cache for Redis) MUST use port 6380 with TLS enabled.
# TLS is turned on automatically WHENEVER REDIS_PORT=6380 (the app enables the
# TLS socket based on the port — there is no separate REDIS_TLS flag), so prod
# config is simply:
#   REDIS_HOST=<your-cache>.redis.cache.windows.net
#   REDIS_PORT=6380          # 6380 => TLS ON (non-TLS port 6379 is disabled on Azure)
#   REDIS_PASSWORD=<access-key-from-azure-key-vault>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────
# IMPORTANT: Generate secure random secrets for production (min 32 chars)
# Use: openssl rand -hex 32
JWT_SECRET=generate-a-secure-random-string-here-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=generate-another-secure-random-string-here-min-32-chars
JWT_REFRESH_EXPIRATION=7d
# Dedicated signing secret for STORE CUSTOMER access tokens ('jwt-customer'
# strategy). This isolates customer tokens from platform (admin/applicant/
# investor) tokens: a platform token signed with JWT_SECRET is cryptographically
# rejected on the customer path, and vice-versa.
# IMPORTANT: In production this MUST be set AND MUST DIFFER from JWT_SECRET —
# the app fails to boot if it is missing/weak in prod, and warns in non-prod if
# it equals JWT_SECRET. When unset, the code falls back to JWT_SECRET (no
# isolation) purely so existing dev setups keep working — do NOT rely on that
# fallback in production.
JWT_CUSTOMER_SECRET=generate-a-distinct-secure-random-string-here-min-32-chars

# ─── AWS ──────────────────────────────────────────────
# IMPORTANT: Use IAM roles in production, never commit real credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_S3_BUCKET=your-s3-bucket-name

# ─── App ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional: extra CORS origins (comma-separated) honoured by HTTP + the store
# Socket.io gateways (/store/stock, /store/orders) in addition to FRONTEND_URL.
# ADDITIONAL_CORS_ORIGINS=https://preview.aryavartham.com,https://staging.aryavartham.com
BATCH_CAPACITY=100

# ─── Google Auth ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Discord (OPTIONAL — storefront "Login with Discord") ─────────────
# All THREE must be set to enable Discord login. When any is absent the feature is
# fully gated OFF: GET /api/store/auth/discord/url returns 404 and the storefront
# "Continue with Discord" button is hidden (mirrors the Google-OAuth / disabled-CTA
# gating pattern). Create an application at https://discord.com/developers/applications,
# enable OAuth2, and add the redirect URI below to its "Redirects" allow-list.
# Scope requested is the minimal `identify email`; an unverified Discord email is
# rejected. The Customer is matched/created by email (NO discordId column).
# DISCORD_CLIENT_ID=your-discord-application-client-id
# DISCORD_CLIENT_SECRET=your-discord-application-client-secret
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
#
# Article → Discord channel announcements (newly PUBLISHED articles) are NOT an env
# var: the incoming-webhook URL is read at runtime from the SiteSettings key
# `discordArticleWebhookUrl` (set it via the admin settings). Absent/blank ⇒ the
# announcement is a silent no-op (feature gated OFF). Create the webhook in Discord:
# Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL.

# ─── Razorpay ─────────────────────────────────────────
# IMPORTANT: Never commit real API keys. Use environment injection in CI/CD
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=generate-a-secure-webhook-secret-here
# Separate webhook secret for the STORE webhook (POST /api/store/webhooks/razorpay).
# Configure a dedicated store webhook URL in the Razorpay dashboard with this secret so
# store order events are verified independently of pledge events (shared-account routing).
RAZORPAY_STORE_WEBHOOK_SECRET=generate-a-separate-store-webhook-secret-here

# ─── Shipping / Courier (architecture 4.9 / 8.4) ──────────
# Active courier provider: 'manual' (default) or 'shiprocket'. Also settable at
# runtime via the SiteSettings key `store.courierProvider` (settings override env).
COURIER_PROVIDER=manual
# HMAC-SHA256 secret for the courier tracking webhook
# (POST /api/store/webhooks/courier). MANDATORY IN PRODUCTION: when NODE_ENV=production
# and this is unset the webhook is REJECTED (401) — an unsigned webhook would let an
# attacker forge DELIVERED events (mark orders delivered, open the returns window,
# advance the order state machine). In development it may be left blank (unsigned
# payloads accepted, logged). Header: X-Courier-Signature (a leading 'sha256='
# prefix is tolerated). Set this in Azure Container Apps before go-live.
COURIER_WEBHOOK_SECRET=
# Optional per-provider override secrets for the named webhook variant
# (POST /api/store/webhooks/courier/:courier). When set, a callback to
# .../courier/delhivery is verified with DELHIVERY_WEBHOOK_SECRET and
# .../courier/shiprocket with SHIPROCKET_WEBHOOK_SECRET; each falls back to the
# shared COURIER_WEBHOOK_SECRET above when its provider-specific value is absent.
# DELHIVERY_WEBHOOK_SECRET=
# SHIPROCKET_WEBHOOK_SECRET=
# Shiprocket adapter (only used when COURIER_PROVIDER=shiprocket). Absent token →
# the provider throws COURIER_NOT_CONFIGURED and the ship() flow falls back to manual.
SHIPROCKET_TOKEN=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# ─── WhatsApp Business API (WABA) ─────────────────────────
# Set up via Meta Business Suite → WhatsApp → API Setup
# WHATSAPP_API_TOKEN:    Permanent token from a System User in Meta Business Manager
# WHATSAPP_PHONE_ID:     Phone Number ID from WhatsApp > API Setup (NOT the phone number itself)
# WHATSAPP_WABA_ID:      WhatsApp Business Account ID
# WHATSAPP_VERIFY_TOKEN: Any secret string you choose — must match what you enter in Meta webhook settings
# WHATSAPP_APP_SECRET:   Facebook App Secret (Meta App Dashboard → Settings → Basic → App Secret)
#                        Used to validate X-Hub-Signature-256 on incoming webhook events
WHATSAPP_API_TOKEN=your_meta_permanent_system_user_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_WABA_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your_facebook_app_secret

# ─── Seed (set only when you need the auto-seed to create/verify the admin) ──
# IMPORTANT: Use a strong password (min 16 chars, mixed case + symbols)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password
