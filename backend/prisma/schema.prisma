// ─── EQUITY & COMPANY SYSTEM ─────────────────────────────

enum CompanyStatus {
  FORMATION // Team formed, company being set up
  INCORPORATED // Legally incorporated
  ACTIVE // Operating with platform equity stake
  SUSPENDED // Temporarily suspended
  HANDED_OVER // 1000-day period complete, equity transferred
  DISSOLVED // Company dissolved
}

enum EquityEventType {
  GRANT // Initial equity allocation
  VEST // Equity vesting milestone
  DILUTE // Dilution event (funding round)
  TRANSFER // Transfer between holders
  HANDOVER // 1000-day handover from platform to founders
  BUYOUT // Early buyout of platform stake
}

enum AgreementStatus {
  DRAFT // Agreement being prepared
  PENDING_SIGNATURE // Sent for signatures
  ACTIVE // Fully executed and active
  AMENDED // Original amended with new terms
  EXPIRED // Agreement term ended
  TERMINATED // Prematurely terminated
}

model CompanyEntity {
  id                 String        @id @default(uuid()) @db.Uuid
  teamId             String        @unique @map("team_id") @db.Uuid
  companyName        String        @map("company_name")
  registrationNumber String?       @map("registration_number") // CIN or company reg number
  incorporationDate  DateTime?     @map("incorporation_date")
  status             CompanyStatus @default(FORMATION)

  // 1000-day timer
  timerStartDate DateTime? @map("timer_start_date")
  timerEndDate   DateTime? @map("timer_end_date") // Computed: timerStartDate + 1000 days
  daysElapsed    Int       @default(0) @map("days_elapsed") // Cached, updated by cron
  handoverDate   DateTime? @map("handover_date") // Actual date when handover occurred

  // Platform's equity stake
  platformEquityPct Float @default(51.0) @map("platform_equity_pct") // Current platform %
  foundersEquityPct Float @default(49.0) @map("founders_equity_pct") // Current founders %

  // Company details
  sector            String?
  description       String? @db.Text
  registeredAddress String? @map("registered_address") @db.Text
  gstin             String? // GST Identification Number
  panNumber         String? @map("pan_number") // Company PAN

  // Metadata
  notes     String?  @db.Text // Admin notes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  equityHolders    EquityHolder[]
  equityAgreements EquityAgreement[]
  equityEvents     EquityEvent[]

  @@index([status])
  @@index([timerEndDate])
  @@map("company_entities")
}

model EquityHolder {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  applicantId     String?  @map("applicant_id") @db.Uuid // null = platform itself
  holderName      String   @map("holder_name") // "Aryavartham Platform" or person name
  holderType      String   @map("holder_type") // "PLATFORM" | "FOUNDER" | "INVESTOR"
  equityPct       Float    @map("equity_pct") // Current equity percentage
  vestedPct       Float    @default(0) @map("vested_pct") // How much has vested
  vestingSchedule Json?    @map("vesting_schedule") // { cliff, duration, intervals }
  isActive        Boolean  @default(true) @map("is_active")
  grantedAt       DateTime @default(now()) @map("granted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   CompanyEntity @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicant Applicant?    @relation(fields: [applicantId], references: [id])

  @@unique([companyId, applicantId])
  @@index([companyId])
  @@index([applicantId])
  @@map("equity_holders")
}

model EquityAgreement {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  agreementType String          @map("agreement_type") // "FOUNDING" | "VESTING" | "HANDOVER" | "BUYOUT"
  title         String
  status        AgreementStatus @default(DRAFT)

  // Agreement terms
  terms     Json? // Flexible JSON for specific terms
  equityPct Float?    @map("equity_pct") // Equity percentage this agreement covers
  duration  Int? // Duration in days (e.g., 1000)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Signatures
  platformSignedAt DateTime? @map("platform_signed_at")
  platformSignedBy String?   @map("platform_signed_by") // Admin who signed
  founderSignedAt  DateTime? @map("founder_signed_at")
  founderSignedBy  String?   @map("founder_signed_by") @db.Uuid // Applicant ID

  // Document
  documentUrl String? @map("document_url") // Link to agreement PDF

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company CompanyEntity @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("equity_agreements")
}

model EquityEvent {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  eventType EquityEventType @map("event_type")

  // Transfer details
  fromHolder       String? @map("from_holder") // Holder name (for audit trail)
  toHolder         String? @map("to_holder") // Holder name (for audit trail)
  percentageAmount Float   @map("percentage_amount") // % transferred or changed

  // Resulting state
  platformEquityAfter Float? @map("platform_equity_after") // Platform % after event
  foundersEquityAfter Float? @map("founders_equity_after") // Founders % after event

  // Context
  description String  @db.Text
  metadata    Json? // Additional event-specific data
  triggeredBy String? @map("triggered_by") // Admin ID or "SYSTEM"
  dayNumber   Int?    @map("day_number") // Day of the 1000-day timer

  createdAt DateTime @default(now()) @map("created_at")

  company CompanyEntity @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([eventType])
  @@index([createdAt])
  @@map("equity_events")
}

